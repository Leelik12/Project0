    \u041B\u0438\u0444\u0442  \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442  \u0432\u0441\u0435\u0433\u0434\u0430: 
    \u043A\u043E\u043F\u0438\u0442\u044C  \u0442\u043E\u0436\u0435  \u0432\u044B\u0431\u043E\u0440. 
    \u0421  \u043A\u0430\u0436\u0434\u044B\u043C  \u044D\u0442\u0430\u0436\u043E\u043C 
    \u0432\u0440\u0430\u0433\u0438  \u0441\u0438\u043B\u044C\u043D\u0435\u0435!"
